# Modelo das variáveis de ambiente. Copie para o arquivo de ambiente local e preencha.
# Nunca coloque valores reais neste arquivo.

# ── Banco de dados (Supabase / Postgres) ──────────────────────────────
# Pooler (porta 6543), usado em runtime
DATABASE_URL="postgresql://postgres.<ref>:<senha>@<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432), usada só por prisma migrate
DIRECT_URL="postgresql://postgres.<ref>:<senha>@<regiao>.pooler.supabase.com:5432/postgres"

# ── Supabase (Realtime no navegador) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# ── BetterAuth ────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="<segredo-aleatorio>"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── E-mail (SMTP) ─────────────────────────────────────────────────────
EMAIL_FROM="noreply@exemplo.com"
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<usuario>"
SMTP_PASS="<senha>"

# ── CRM: check-in integrado no totem de teste (/recepcao-crm) ────────
# "true" liga o totem de teste; qualquer outro valor deixa a rota como página inexistente.
CRM_CHECKIN_ENABLED="false"
# Endereço das funções do CRM, sem a barra final.
CRM_BASE_URL="https://<ref-do-crm>.supabase.co/functions/v1"
# Chave enviada no header x-api-key. Segredo: só no servidor, nunca com prefixo NEXT_PUBLIC_.
CRM_API_KEY="<chave-fornecida-pela-clinica>"
# Tempo limite por chamada, em milissegundos.
CRM_TIMEOUT_MS="8000"
