{
  "enabledPlugins": {
    "nos-core@nos-ai": true,
    "perfil-nextjs-supabase@nos-ai": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development*)",
      "Read(./.env.production*)",
      "Read(./.env.test*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development*)",
      "Edit(./.env.production*)",
      "Edit(./.env.test*)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.*.local)",
      "Write(./.env.development*)",
      "Write(./.env.production*)",
      "Write(./.env.test*)"
    ]
  }
}
